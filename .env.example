# Better Auth
# Generate a secret with: npx @better-auth/cli secret  (or: openssl rand -base64 32)
BETTER_AUTH_SECRET=replace-me-with-a-random-secret
# Public base URL. Locally use http://localhost:3000.
# On Railway you can omit this — it falls back to https://$RAILWAY_PUBLIC_DOMAIN.
BETTER_AUTH_URL=http://localhost:3000

# Discord OAuth application (https://discord.com/developers/applications)
# Local redirect URL:      http://localhost:3000/api/auth/callback/discord
# Production redirect URL:  https://<your-domain>/api/auth/callback/discord
DISCORD_CLIENT_ID=your-discord-client-id
DISCORD_CLIENT_SECRET=your-discord-client-secret

# SQLite database file path.
# Locally defaults to ./sqlite.db. On Railway, point this at a mounted volume
# so data survives deploys, e.g. DATABASE_PATH=/data/sqlite.db
# DATABASE_PATH=/data/sqlite.db

# Dev mode in production: comma-separated VATSIM CIDs allowed to use the
# CID/Discord override bar in prod. In development it's on for everyone.
# DEV_CIDS=1897191,1234567

# Optional: some VATUSA endpoints accept an API key. Not required for public reads.
# VATUSA_API_KEY=
